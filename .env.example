# / uses this project's /v1 backend on the same origin.
# Empty = explicit browser demo, no uploads, translation or payments.
NEXT_PUBLIC_API_BASE_URL=/
NEXT_PUBLIC_SITE_URL=https://dubbingnow.com

# Auth0 SPA + custom API audience. All three required for live sign-in.
# Domain is a hostname, e.g. your-tenant.us.auth0.com (no https://).
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
# Cloudflare Turnstile public site key for guest trial verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only settings below. Never prefix secrets with NEXT_PUBLIC_.
# Cloudflare persists all application state. Use local only for isolated development/tests.
PERSISTENCE_DRIVER=cloudflare
# Vercel deployments use vercel-queue; a separate Node process uses worker.
JOB_EXECUTION=worker
# Vercel invokes the daily orphan-audio cleanup with this private bearer secret.
CRON_SECRET=
BACKEND_LOCAL=false
BACKEND_PUBLIC_URL=https://dubbingnow.com
CLOUDFLARE_ACCOUNT_ID=b298efaeaa5e9f207c34f0566c6e509d
CLOUDFLARE_D1_DATABASE_ID=7195762f-45ea-4c11-ad3c-a9dbbb5a5587
CLOUDFLARE_D1_API_TOKEN=
CLOUDFLARE_R2_BUCKET=dubbingnow-audio
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Optional scratch directory, defaults to the OS temp directory. Never stores the database.
BACKEND_TEMP_DIR=
# Only used with PERSISTENCE_DRIVER=local.
BACKEND_DATA_DIR=.data
STORAGE_SIGNING_SECRET=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_HIGH_FIDELITY_TTS_MODEL=gemini-3.8-flash-tts
# Google handles transcription/translation; Fish clones each task's selected reference.
CLONE_PROVIDER=fish
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
# Used only in explicit saved_test mode; ignored by inline and per_job.
FISH_REFERENCE_ID=
# inline uses the task's reference without creating a saved voice or consuming a clone slot.
# saved_test explicitly reuses the existing test voice. per_job registers a private voice model.
FISH_VOICE_MODE=inline
# Only affects per_job. Inline cloning never creates a saved model.
FISH_ALLOW_VOICE_CREATION=false
# First-release limits; policy can lower these further. Daily budgets use UTC days.
MAX_DURATION_SECONDS=300
MAX_SPEAKERS=1
MAX_FILE_BYTES=100000000
SIGNUP_CREDITS_CAP=50
MAX_ACTIVE_JOBS=20
MAX_QUEUE_WAIT_SECONDS=600
MAX_JOB_RUN_SECONDS=900
USER_DAILY_AUDIO_SECONDS=1800
GLOBAL_DAILY_AUDIO_SECONDS=18000
USER_DAILY_UPLOAD_BYTES=500000000
GLOBAL_DAILY_UPLOAD_BYTES=5000000000
# Build-time service contact details; required by production preflight.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
MIN_FREE_DISK_BYTES=250000000
PAUSE_NEW_JOBS=false
# Bounded per-stage concurrency, 1–8. Use 1 for a serial benchmark; default 3.
SYNTHESIS_CONCURRENCY=3
# combined transcribes + translates in one request; separate is the baseline.
TEXT_PIPELINE=combined
# Optional SSE sentence pipeline for an existing saved Fish voice; measured separately.
STREAM_TEXT_PIPELINE=false
# Empty paths use the executables on PATH. Both are required for audio processing.
FFMPEG_PATH=
FFPROBE_PATH=
# HTTPS issuer (ending in /) and audience; empty falls back to the public Auth0 values.
AUTH0_ISSUER=
AUTH0_AUDIENCE=
# Comma-separated trusted Auth0 subjects, applied only when a new user is created.
AUTH0_ADMIN_SUBJECTS=
TURNSTILE_SECRET_KEY=
# Additional full origins, comma-separated; BACKEND_PUBLIC_URL is always allowed.
API_ALLOWED_ORIGINS=
# True only behind a proxy that replaces/controls X-Forwarded-For and blocks direct access.
TRUST_PROXY=false
GUEST_IP_TRIAL_USES=3

# Optional local network proxy, only if your machine already uses one.
# Requires Node 22.21+; set NODE_OPTIONS=--use-env-proxy and the proxy URLs locally.
# Keep empty on a server with direct outbound access.
NODE_OPTIONS=
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost
