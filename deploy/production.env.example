# Build and run with these SAME values. Install as /etc/web-vc/environment (mode 600).
NODE_ENV=production
BACKEND_LOCAL=false
BACKEND_PUBLIC_URL=https://example.invalid
BACKEND_DATA_DIR=/var/lib/web-vc
STORAGE_SIGNING_SECRET=
NEXT_PUBLIC_API_BASE_URL=/
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=
TURNSTILE_SECRET_KEY=
AUTH0_ISSUER=
AUTH0_AUDIENCE=
AUTH0_ADMIN_SUBJECTS=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
CLONE_PROVIDER=fish
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro
FISH_VOICE_MODE=inline
# Only legacy per_job mode creates saved voice models. Inline needs no creation permission.
FISH_ALLOW_VOICE_CREATION=false
FISH_REFERENCE_ID=
SYNTHESIS_CONCURRENCY=3
TEXT_PIPELINE=combined
STREAM_TEXT_PIPELINE=false
TRUST_PROXY=true
API_ALLOWED_ORIGINS=
GUEST_IP_TRIAL_USES=3
MAX_DURATION_SECONDS=300
MAX_SPEAKERS=1
MAX_FILE_BYTES=100000000
SIGNUP_CREDITS_CAP=50
MAX_ACTIVE_JOBS=20
MAX_QUEUE_WAIT_SECONDS=600
MAX_JOB_RUN_SECONDS=900
USER_DAILY_AUDIO_SECONDS=1800
GLOBAL_DAILY_AUDIO_SECONDS=18000
USER_DAILY_UPLOAD_BYTES=500000000
GLOBAL_DAILY_UPLOAD_BYTES=5000000000
MIN_FREE_DISK_BYTES=500000000
PAUSE_NEW_JOBS=false
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
