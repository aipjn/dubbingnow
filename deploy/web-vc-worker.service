[Unit]
Description=Web VC audio worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web-vc
Group=web-vc
WorkingDirectory=/srv/web-vc/current
EnvironmentFile=/etc/web-vc/environment
ExecStartPre=/usr/bin/node --import tsx server/scripts/preflight.ts
ExecStart=/usr/bin/node --import tsx server/worker.ts
Restart=on-failure
RestartSec=5
# Let the bounded active job settle before stopping.
TimeoutStopSec=930
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/web-vc

[Install]
WantedBy=multi-user.target
