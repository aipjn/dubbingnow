# Replace example.invalid and certificate paths. Only nginx is public; Node stays on loopback.
server {
    listen 80;
    server_name example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name example.invalid;
    ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
    client_max_body_size 100m;
    client_body_timeout 120s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite instead of trusting/forwarding client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # Avoid recording signed upload/download ticket query strings.
        access_log off;
    }
}
